# LLM (Google Gemini) -- required
export GOOGLE_API_KEY=your-gemini-api-key

# LLM provider/model (optional; these are the defaults)
export LLM_PROVIDER=google_genai
export LLM_MODEL=gemini-3.8-flash

# Data source: a Parquet file or URL. Defaults to a local 2024-01 taxi file.
# The public NYC TLC CloudFront URL also works without any download:
export PARQUET_PATH=https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2024-01.parquet

# Logging (optional)
export LOG_LEVEL=INFO

# API key guarding write endpoints (POST /documents). Set any value in prod.
export API_KEY=

# Slack connector (optional; only needed to run the Slack bot)
export SLACK_BOT_TOKEN=xoxb-...
export SLACK_APP_TOKEN=xapp-...
